# Copy: cp .env.example .env.local  (real values never go into git)
# .NET API root (without a trailing /api). Vercel preview → dev API, production → prod API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7071
# Site root for sitemap/canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Firebase web configuration (not secret; from the Firebase console)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-culinode.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-culinode
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Local development only: Firebase Auth Emulator (must be empty in production)
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
