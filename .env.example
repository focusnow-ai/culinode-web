# Kopyala: cp .env.example .env.local  (gerçek değerler git'e girmez)
# .NET API kökü (sonunda /api olmadan). Vercel preview → dev API, production → prod API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7071
# Sitemap/canonical için site kökü
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Firebase web yapılandırması (gizli değildir; Firebase konsolundan)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-culinode.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-culinode
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Yalnız yerel geliştirme: Firebase Auth Emulator (production'da boş bırakılmalı)
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
